{"status":"OK","data":{"id":19250,"identifier":"UJ/VRJ85T","persistentUrl":"https://doi.org/10.57903/UJ/VRJ85T","protocol":"doi","authority":"10.57903","separator":"/","publisher":"Jagiellonian University in Kraków","publicationDate":"2024-10-10","storageIdentifier":"s3://10.57903/UJ/VRJ85T","metadataLanguage":"en","datasetType":"dataset","latestVersion":{"id":930,"datasetId":19250,"datasetPersistentId":"doi:10.57903/UJ/VRJ85T","datasetType":"dataset","storageIdentifier":"s3://10.57903/UJ/VRJ85T","versionNumber":1,"internalVersionNumber":16,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","deaccessionLink":"","lastUpdateTime":"2025-12-31T11:03:38Z","releaseTime":"2024-10-10T09:09:19Z","createTime":"2024-10-09T13:26:35Z","publicationDate":"2024-10-10","citationDate":"2024-10-10","license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"XANES reference database of sulphur containing compounds for biological research: A preliminary report from the ASTRA Beamline at the SOLARIS Synchrotron Radiation Centre"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Klonecka, Agnieszka"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"Jagiellonian University in Kraków, Doctoral School of Exact and Natural Sciences"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":true,"typeClass":"primitive","value":["0000-0001-9577-6183"]}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Klonecka, Agnieszka"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Jagiellonian University in Kraków"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"a.klonecka@doctoral.uj.edu.pl"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"X-ray absorption near edge structure (XANES) spectroscopy at the sulphur K-absorption edge was used to investigate sulphur containing compounds of biological interest at the ASTRA beamline (SOLARIS National Synchrotron Radiation Centre, Kraków, Poland)."}}]},{"typeName":"abstract","multiple":false,"typeClass":"compound","value":{"abstractField":{"typeName":"abstractField","multiple":false,"typeClass":"primitive","value":"Sulphur is present in a vast multitude of biological compounds, and X-ray absorption spectroscopy (XAS) is a powerful and well-established characterization technique to study the local atomic environment of this chemical element in such systems in detail. For this project, X-ray absorption near edge structure (XANES) spectroscopy at the sulphur K-absorption edge was used to investigate sulphur containing compounds of biological interest at the ASTRA beamline (SOLARIS National Synchrotron Radiation Centre, Kraków, Poland). XANES provides valuable insights into the chemical state, i.e. chemical state, and coordination chemistry of sulphur atoms in biological compounds and thereby contributes to a deeper understanding of the structural characteristics and functional roles of sulphur in biological systems. The ASTRA beamline offers a possibility for further research in this field, enabling detailed analysis of the composition and changes in sulphur- containing compounds. In general, X-ray absorption spectroscopy has significant potential for advancing knowledge in medicine, biotechnology and environmental research."}}},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"XANES"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"sulphur"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"biological compounds"}}]},{"typeName":"mein2023","multiple":true,"typeClass":"compound","value":[{"subjectField":{"typeName":"subjectField","multiple":false,"typeClass":"controlledVocabulary","value":"76"}}]},{"typeName":"oecd","multiple":true,"typeClass":"compound","value":[{"oecdList":{"typeName":"oecdList","multiple":false,"typeClass":"controlledVocabulary","value":"14"}}]},{"typeName":"languageMain","multiple":true,"typeClass":"compound","value":[{"language":{"typeName":"language","multiple":false,"typeClass":"controlledVocabulary","value":"English"}}]},{"typeName":"funding","multiple":true,"typeClass":"compound","value":[{"fundingAgency":{"typeName":"fundingAgency","multiple":false,"typeClass":"controlledVocabulary","value":"National Science Center (NCN)"},"fundingName":{"typeName":"fundingName","multiple":false,"typeClass":"primitive","value":"Preludium BIS 2 : High pressure studies of protein structure on the SOLCRYS beam line at the SOLARIS National Synchrotron Radiation Center,"},"fundingID":{"typeName":"fundingID","multiple":false,"typeClass":"primitive","value":"2020/39/O/ST4/03465"},"grantInfo":{"typeName":"grantInfo","multiple":false,"typeClass":"primitive","value":"https://ror.org/03ha2q922"}}]},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"Klonecka,