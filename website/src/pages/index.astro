  .entry-heading h2 a{text-decoration:none}.entry-heading h2 a:hover{text-decoration:underline;text-underline-offset:5px}.api-links{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:18px}.api-links a{font-size:11px;font-weight:650;text-decoration:none}.api-links a:hover{text-decoration:underline}
  .explainer{font-size:15px;line-height:1.8;color:#3f4a45;max-width:760px;margin:28px 0 0}.facts{list-style:none;padding:0;margin:34px 0 0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.facts li{border-top:2px solid #cfd5c8;padding-top:12px;display:flex;flex-direction:column;gap:4px}.facts strong{font-size:13px;font-weight:650}.facts span{font-size:11px;color:#5f6a5d}
