,"typeClass":"primitive","value":"Ramisetty, Ramakrishna"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"TOFWERK AG"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Hoffmann, Patrik"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"EPFL, École Polytechnique Fédérale de Lausanne"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0002-7924-6219"}},{"contributorName":{"typeName":"contributorName","multiple":false,"typeClass":"primitive","value":"Utke, Ivo"},"contributorAffiliation":{"typeName":"contributorAffiliation","multiple":false,"typeClass":"primitive","value":"Empa, Swiss Federal Laboratories for Materials Science and Technology"},"contributorIdScheme":{"typeName":"contributorIdScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"contributorId":{"typeName":"contributorId","multiple":false,"typeClass":"primitive","value":"0000-0002-9877-2601"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Sikora, Marcin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Jagiellonian University in Kraków"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"marcin1.sikora@uj.edu.pl"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Raw data of X-ray absorption spectroscopy and Time-of-flight mass spectroscopy as well as processed, high-quality images collected by means of scanning electron and atomic force microscopes."}}]},{"typeName":"abstract","multiple":false,"typeClass":"compound","value":{"abstractField":{"typeName":"abstractField","multiple":false,"typeClass":"primitive","value":"The development of high-quality copper (Cu) thin films by atomic layer deposition (ALD) remains challenging due to limited understanding of the reaction mechanisms that govern film growth and composition. To address this gap, in this study time-of-flight mass spectrometry (TOFMS) was used to perform the first comprehensive in-situ investigation of the surface reactions during Cu ALD, using dehydrated Cu(II) hexafluoroacetylacetonate (Cu(hfac)2) (CAS 14781-45-4) and diethylzinc (DEZ, ZnEt2) (CAS 557-20-0). The high sensitivity and mass resolution of TOFMS enabled the identification of previously only hypothesized surface reaction volatile by-products, revealing two different mechanisms in each ALD half-cycle. During the Cu(hfac)2 pulse, both Zn(hfac)2 and EtZn(hfac) volatile by-products were detected in varying amounts, while the DEZ pulse predominantly yielded EtZn(hfac). The relative intensities of the Zn-containing MS ions observed during Cu(hfac)2 and DEZ half-cycle indicate that approximately 90% of them are formed during the DEZ half-cycle. X-ray absorption spectroscopy (XAS) of the as-deposited films confirmed the formation of metallic copper, with minimal zinc (Zn) and carbon (C) incorporation. The results underline simultaneous full and half ligand exchange mechanism during the precursor pulse, resulting in a surface saturated with hfac ligands. However, the reaction mostly happens in the DEZ half-cycle, which is dominated by partial ligand exchange pathway, leading to the saturation surface being composed of Zn species. This study provides the first experimental evidence of the mechanistic pathways for copper deposition and demonstrates the value of in-situ TOFMS for monitoring ALD reaction mechanisms, a critical aspect for process development and optimization."}}},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"XAS"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"TOF-MS"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Cu films"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"ALD"}}]},{"typeName":"mein2023","multiple":true,"typeClass":"compound","value":[{"subjectField":{"typeName":"subjectField","multiple":false,"typeClass":"controlledVocabulary","value":"76"}},{"subjectField":{"typeName":"subjectField","multiple":false,"typeClass":"controlledVocabulary","value":"77"}},{"subjectField":{"typeName":"subjectField","multiple":false,"typeClass":"controlledVocabulary","value":"28"}}]},{"typeName":"oecd","multiple":true,"typeClass":"compound","value":[{"oecdList":{"typeName":"oecdList","multiple":false,"typeClass":"controlledVocabulary","value":"14"}},{"oecdList":{"typeName":"oecdList","multiple":false,"typeClass":"controlledVocabulary","value":"13"}},{"oecdList":{"typeName":"oecdList","multiple":false,"typeClass":"controlledVocabulary","value":"25"}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"controlledVocabulary","value":"Relation4"},"publicationAuthor":{"typeName":"publicationAuthor","multiple":false,"typeClass":"primitive","value":"Minzoni, C., Klejna, S., Mackosz, K., Hain, C., Figura-Jagoda, A., Szkudlarek, A., Sikora, M., Werbrouck, A., Ramisetty, R., Hoffmann, P., Utke, I. (2025) :"},"publicationTitle":{"typeName":"publicationTitle","multiple":false,"typeClass":"primitive","value":"Reaction Mechanisms in Copper Atomic Layer Deposition Using Copper(II) Hexafluoroacetylaceto