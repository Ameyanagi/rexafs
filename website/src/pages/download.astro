---
import release from '../data/release.json';
import { url } from '../lib/urls';
const canonical=new URL(url('download/'),Astro.site).href;
const ogImage=new URL(url('brand/rexafs-og.jpg'),Astro.site).href;
const platforms = [...new Set(release.platforms.map(platform => platform.os))].map(os => {
  const packages = release.platforms.filter(platform => platform.os === os);
  const sharedNote = packages.every(pkg => pkg.note === packages[0].note) ? packages[0].note : null;
  return { os, packages, sharedNote };
});
const architectureLabel = (arch: string) => arch === 'Apple Silicon' ? 'Apple Silicon (ARM64)' : arch === 'Intel' ? 'Intel (x64)' : arch;

---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Download rexafs {release.version}</title><meta name="description" content="Download verified stable rexafs desktop packages for macOS, Windows and Linux, or install the Python, TypeScript and Rust libraries."/><link rel="icon" href={url('favicon.svg')}/><link rel="canonical" href={canonical}/><meta property="og:title" content={`Download rexafs ${release.version}`}/><meta property="og:description" content="Free, open-source X-ray absorption analysis for macOS, Windows and Linux, plus Python, TypeScript and Rust packages."/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href={url()}><img src={url('favicon.svg')} width="27" height="27" alt=""/>rexafs</a><nav aria-label="Main navigation"><a href={url('docs/desktop/')}>Desktop</a><a href={url('docs/libraries/')}>Libraries</a><a href={url('docs/getting-started/install/')}>Installation guide</a><a href="https://github.com/Ameyanagi/rexafs">GitHub <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><p class="eyebrow">STABLE {release.version} · VERIFIED {release.verified}</p><h1>Download rexafs.</h1><p class="intro">Choose your operating system and processor. The desktop runs locally without Python or Rust.</p>
<div class="downloads">{platforms.map((platform, platformIndex) => <article>
  <h2>{platform.os}</h2>
  {platform.sharedNote !== null && <p class="platform-note" id={`platform-note-${platformIndex}`}>{platform.sharedNote}</p>}
  <ul class="architectures">{platform.packages.map((pkg, packageIndex) => <li>
    <a class="download" href={pkg.url} aria-label={`Download for ${platform.os}, ${architectureLabel(pkg.arch)}`} aria-describedby={platform.sharedNote !== null ? `platform-note-${platformIndex}` : `package-note-${platformIndex}-${packageIndex}`}>{architectureLabel(pkg.arch)} <span aria-hidden="true">↓</span></a>
    {platform.sharedNote === null && <p class="package-note" id={`package-note-${platformIndex}-${packageIndex}`}>{pkg.note}</p>}
    <a class="checksum" href={pkg.sha256} aria-label={`SHA-256 checksum for ${platform.os}, ${architectureLabel(pkg.arch)}`}>SHA-256 checksum</a>
  </li>)}</ul>
  {!platform.packages.some(pkg => /arm64|aarch64|apple silicon/i.test(pkg.arch)) && <p class="unavailable"><strong>ARM64</strong> · No desktop package in {release.version}.
    <a href={url('docs/getting-started/install/#arm64-availability')}>Next-release plans →</a>
  </p>}
</article>)}</div>
<p class="support">macOS desktop and Python packages require Apple Silicon from 0.2.12. Intel Mac users can keep the archived <a href="https://github.com/Ameyanagi/rexafs/releases/tag/v0.2.11">0.2.11 release</a>. For Apple Silicon Macs running 0.2.10 or 0.2.11, install the new DMG manually once to acquire the corrected updater.</p>
<p class="support"><a href={url('app/')}>Try the browser preview →</a> · <a href={url('docs/getting-started/install/')}>Installation, system requirements and checksum verification →</a></p>
<section><h2>Use the libraries</h2><p class="section-lede">Python and TypeScript expose spectrum processing. Rust also includes structures and fitting.</p><div class="packages"><article><h3>Python</h3><p class="pkg-note">CPython 3.10–3.14 · NumPy</p><pre><code>uv add rexafs=={release.version}</code></pre><a href={url('docs/libraries/python/')}>Project setup and quick start →</a></article><article><h3>TypeScript / JavaScript</h3><p class="pkg-note">Node 22+ and browsers · WebAssembly</p><pre><code>bun add rexafs@{release.version}</code></pre><a href={url('docs/libraries/typescript/')}>Node and browser guide →</a></article><article><h3>Rust</h3><p class="pkg-note">Full API · optional calculation engines</p><pre><code>cargo add rexafs@{release.version}</code></pre><a href={url('docs/libraries/rust/')}>Rust guide →</a></article></div></section>
<p class="links"><a href={release.releaseUrl}>Release notes and all assets ↗</a> · <a href={url('releases/')}>Release history</a> · <a href={url('docs/getting-started/updates/')}>Updates and offline installation</a> · <a href={url('docs/troubleshooting/')}>Troubleshooting</a></p>
</main><footer><span>rexafs · open source under MIT or Apache-2.0</span><nav aria-label="Footer"><a href={url('docs/getting-started/')}>Documentation</a><a href={url('licenses/')}>Licenses and data</a><a href="https://github.com/Ameyanagi/rexafs/issues">Get help ↗</a></nav></footer></body></html>
<style> :global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f7f2;color:#26342c;font-family:Inter,ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}:global(a){color:#365e4b}:global(a:focus-visible){outline:3px solid #00747c;outline-offset:5px}.skip{position:fixed;top:-80px;left:12px;background:white;padding:12px;z-index:100}.skip:focus{top:12px}header,main,footer{max-width:1200px;margin:auto;padding:30px 40px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid #d5dacd}header nav{display:flex;gap:25px;font-size:13px;font-weight:600;flex-wrap:wrap}header nav a,footer a,.brand,.download,.checksum,.packages a{text-decoration:none;color:inherit}header nav a:hover,footer nav a:hover{color:#92511f}.brand{display:inline-flex;align-items:center;gap:9px;font-weight:750;font-size:27px;letter-spacing:-1.3px}main{padding-top:65px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:700;color:#5a6762}h1{font-size:clamp(36px,5vw,58px);letter-spacing:-2px;font-weight:550;margin:0 0 20px}.intro{font-size:17px;line-height:1.7;color:#657061;margin:0 0 40px;max-width:720px}.downloads{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}article{min-width:0;border:1px solid #d5dacd;background:white;border-radius:8px;padding:24px}.downloads h2{font-size:25px;letter-spacing:-1px;margin:0}.downloads h2+.architectures{margin-top:18px}.platform-note{font-size:12px;color:#697463;min-height:36px;margin:6px 0 18px}.package-note{font-size:11px;line-height:1.65;color:#606d5c;margin:8px 0 0}.architectures{list-style:none;padding:0;margin:0;display:grid;gap:20px}.unavailable{font-size:12px;line-height:1.7;color:#606d5c;border-top:1px solid #d5dacd;padding-top:16px;margin:20px 0 0}.unavailable a{display:block}.download{background:#2d493d;color:white;border-radius:4px;padding:12px 15px;display:flex;justify-content:space-between;font-size:13px;font-weight:650}.download:hover{background:#20382e}.checksum{font-size:11px;display:block;margin-top:8px;color:#365e4b}.support a,.links a,.section-lede a{text-decoration:underline;text-underline-offset:2px}.support{color:#606d5c;font-size:13px;line-height:1.8;margin:25px 0 48px;max-width:860px}section{border-top:1px solid #d5dacd;padding-top:28px;margin-bottom:44px}section h2{font-size:24px;letter-spacing:-.8px;font-weight:600;margin:0 0 14px}.section-lede{font-size:13px;line-height:1.75;color:#606d5c;max-width:760px;margin:0 0 22px}.packages{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:0}.packages article{padding:18px;display:flex;flex-direction:column}.packages h3{margin:0 0 4px}.pkg-note{font-size:11px;color:#697463;margin:0 0 12px}.packages pre{font-size:11px;overflow:auto;padding-bottom:7px;margin:0 0 14px;flex:1}.packages a{font-size:12px;font-weight:650;color:#365e4b}.links{font-size:13px;line-height:2;margin:0 0 20px}footer{font-size:12px;border-top:1px solid #d5dacd;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#606d5c}footer nav{display:flex;gap:20px}@media(max-width:850px){.downloads,.packages{grid-template-columns:1fr}}@media(max-width:550px){header,main,footer{padding-left:22px;padding-right:22px}header{flex-wrap:wrap}header nav{gap:14px}.downloads,.packages{grid-template-columns:1fr}}</style>
