---
import release from '../data/release.json';
import { url } from '../lib/urls';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Download rexafs {release.version}</title><meta name="description" content="Download verified stable rexafs desktop packages for macOS, Windows and Linux, or install Python, TypeScript and Rust libraries."/><link rel="icon" href={url('favicon.svg')}/><link rel="canonical" href={new URL(url('download/'),Astro.site).href}/></head>
<body><header><a class="brand" href={url()}>rexafs</a><nav aria-label="Main navigation"><a href={url('docs/desktop/')}>Desktop</a><a href={url('docs/libraries/')}>Libraries</a><a href={url('docs/getting-started/install/')}>Installation guide</a></nav></header>
<main><p class="eyebrow">STABLE {release.version}</p><h1>Start your next analysis.</h1><p class="intro">Choose your desktop package, or bring rexafs into your code.</p>
<div class="downloads">{release.platforms.map(platform=><article><h2>{platform.os}</h2><p class="arch">{platform.arch}</p><p>{platform.note}</p><a class="download" href={platform.url}>Download <span aria-hidden="true">↗</span></a><a class="checksum" href={platform.sha256}>SHA-256 checksum</a></article>)}</div>
<p class="support">Windows and Linux are desktop previews. Linux uses the Ubuntu 24.04 runtime baseline and requires a graphical session with a Vulkan driver. See the <a href={url('docs/getting-started/install/')}>platform requirements</a>. ARM64 packages are available for macOS only.</p>
<section><h2>Use the libraries</h2><div class="packages"><article><h3>Python</h3><pre><code>python -m pip install rexafs=={release.version}</code></pre><a href={url('docs/libraries/python/')}>Python quick start →</a></article><article><h3>TypeScript / JavaScript</h3><pre><code>npm install rexafs@{release.version}</code></pre><a href={url('docs/libraries/typescript/')}>Node and browser guide →</a></article><article><h3>Rust</h3><pre><code>cargo add rexafs@{release.version}</code></pre><a href={url('docs/libraries/rust/')}>Rust guide →</a></article></div></section>
<p><a href={release.releaseUrl}>Release notes and all assets ↗</a> · <a href={url('docs/getting-started/updates/')}>Updates and offline installation</a></p>
</main><footer>rexafs · <a href={url('licenses/')}>Licenses and attribution</a></footer></body></html>
<style> :global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f7f2;color:#26342c;font-family:system-ui,sans-serif}:global(a){color:#365e4b}:global(a:focus-visible){outline:3px solid #00747c;outline-offset:5px}header,main,footer{max-width:1200px;margin:auto;padding:30px 40px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d5dacd}header nav{display:flex;gap:25px;font-size:13px}a{text-decoration:none}.brand{font-weight:750;font-size:27px;letter-spacing:-1.3px}main{padding-top:65px}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:700}h1{font-size:clamp(36px,5vw,58px);letter-spacing:-2px;font-weight:550;margin-bottom:20px}.intro{font-size:18px;color:#657061;margin-bottom:40px}.downloads{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}article{min-width:0;border:1px solid #d5dacd;background:white;border-radius:8px;padding:24px}.downloads h2{font-size:25px;letter-spacing:-1px;margin:0}.arch{font-size:15px}.downloads article>p:not(.arch){font-size:12px;color:#697463;min-height:36px}.download{background:#2d493d;color:white;border-radius:4px;padding:12px 15px;display:flex;justify-content:space-between;font-size:13px}.checksum{font-size:11px;display:block;margin-top:15px}.support a{text-decoration:underline;text-underline-offset:2px}.support{color:#606d5c;font-size:13px;line-height:1.8;margin:25px 0 55px}section{border-top:1px solid #d5dacd;padding-top:28px}.packages{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:25px 0 40px}.packages article{padding:18px}.packages h3{margin:0 0 15px}.packages pre{font-size:11px;overflow:auto;padding-bottom:7px}.packages a{font-size:12px}main>p:last-child{font-size:13px}footer{font-size:12px;border-top:1px solid #d5dacd}@media(max-width:850px){.downloads,.packages{grid-template-columns:1fr 1fr}}@media(max-width:550px){header,main,footer{padding-left:22px;padding-right:22px}header{flex-wrap:wrap;gap:20px}header nav{gap:14px}.downloads,.packages{grid-template-columns:1fr}main>p:last-child{line-height:2}}</style>
